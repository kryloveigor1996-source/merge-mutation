# Detect text normally; explicitly keep Godot/editor text as LF on every OS.
* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
*.gd text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.import text eol=lf
*.uid text eol=lf
*.gdextension text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.svg text eol=lf

# Never apply line-ending conversion to binary assets/resources.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.wav binary
*.ogg binary
*.mp3 binary
*.ttf binary
*.otf binary
*.res binary
*.scn binary
*.pck binary
