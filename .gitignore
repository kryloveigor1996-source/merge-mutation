# Godot 4
# Generated cache only. Keep *.png.import settings and *.gd.uid identities in Git.
.godot/
*.log

# Temporary files
*.tmp
*.bak

# Windows
Thumbs.db
Desktop.ini

# macOS
.DS_Store

# Generated workspace outputs (only directory placeholders are tracked).
/logs/**
!/logs/import/
!/logs/import/.gitkeep
!/logs/runtime/
!/logs/runtime/.gitkeep
!/logs/tests/
!/logs/tests/.gitkeep
!/logs/archive/
!/logs/archive/.gitkeep
/builds/**
!/builds/android/
!/builds/android/.gitkeep
!/builds/windows/
!/builds/windows/.gitkeep
*.apk
*.aab

# Local secrets and Android signing credentials.
.env
.env.*
!.env.example
export_credentials.cfg
*.keystore
*.jks
*.p12
*.pfx
*.private.key
*private*.pem
*signing*.pem
